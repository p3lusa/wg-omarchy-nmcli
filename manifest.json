{
  "schemaVersion": 1,
  "id": "io.github.p3lu.wg-omarchy-nmcli",
  "name": "WireGuard VPN",
  "version": "0.4.0",
  "author": "P3lu",
  "license": "MIT",
  "description": "WireGuard VPN widget for the Omarchy bar: left-click opens a themed status panel with IP/gateway/peer/handshake details and DNS control; connect/disconnect via nmcli.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "WireGuard",
    "description": "A themed WireGuard panel (state, IP, gateway, DNS) plus one-click connect/disconnect via nmcli.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "connectionName",
        "type": "string",
        "label": "NM connection name",
        "defaultValue": "wg0"
      },
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Poll interval (seconds)",
        "min": 1,
        "max": 600,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "configFile",
        "type": "string",
        "label": "WireGuard config to import",
        "defaultValue": ""
      }
    ]
  }
}
